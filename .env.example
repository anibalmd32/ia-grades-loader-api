# =============================================================================
#  IA Grades Loader API - Variables de entorno
#  Copia este archivo a .env y completa los valores:  cp .env.example .env
#  Los pasos para obtener cada valor están en el README (sección "Variables de entorno").
# =============================================================================

# --- Aplicación --------------------------------------------------------------
APP_NAME="IA Grades Loader API"
# development | staging | production
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
# Orígenes permitidos para CORS, separados por coma (front Tauri / Vite)
CORS_ORIGINS=http://localhost:1420,tauri://localhost,http://tauri.localhost

# --- Base de datos (MySQL) ---------------------------------------------------
# Formato: mysql+asyncmy://USUARIO:CLAVE@HOST:PUERTO/NOMBRE_BD
DATABASE_URL=mysql+asyncmy://root:CLAVE@localhost:3306/ia_grades_loader_db
# true para ver el SQL generado en consola
DATABASE_ECHO=false

# --- Autenticación (JWT) -----------------------------------------------------
# Genera un valor aleatorio:  uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Longitud de la contraseña generada automáticamente para estudiantes
GENERATED_PASSWORD_LENGTH=10
# No hay credenciales iniciales: el super admin se crea desde el instalador
# (POST /api/v1/setup), que solo está disponible mientras no exista ninguno.

# --- Modelo de IA ------------------------------------------------------------
# Cualquier proveedor compatible con la API de OpenAI (Chat Completions).
# Para cambiar de modelo basta con cambiar estas variables, sin tocar código.
#   DeepSeek : LLM_BASE_URL=https://api.deepseek.com          LLM_MODEL=deepseek-chat
#   OpenAI   : LLM_BASE_URL=https://api.openai.com/v1         LLM_MODEL=gpt-4o-mini
#   Groq     : LLM_BASE_URL=https://api.groq.com/openai/v1    LLM_MODEL=<modelo>
#   Ollama   : LLM_BASE_URL=http://localhost:11434/v1         LLM_MODEL=<modelo local>  (LLM_API_KEY=ollama)
# LLM_PROVIDER es solo una etiqueta informativa (logs / health).
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Telegram ----------------------------------------------------------------
# Token del bot entregado por @BotFather (formato 123456789:AA...)
TELEGRAM_BOT_TOKEN=
# Username del bot sin "@" (se usa para generar el enlace t.me/<username>?start=<codigo>)
TELEGRAM_BOT_USERNAME=
# URL pública HTTPS donde Telegram enviará las actualizaciones.
# Vacío = modo polling (recomendado en desarrollo local).
# Ej.: https://mi-dominio.com/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Secreto que Telegram envía en la cabecera X-Telegram-Bot-Api-Secret-Token.
# Solo letras, números, "_" y "-" (1-256 caracteres). Genera uno con:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# Minutos de validez del código para vincular la cuenta de Telegram
TELEGRAM_LINK_CODE_TTL_MINUTES=10

# --- Carga de archivos -------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10

# --- Cola de importación de notas (Excel + IA) -------------------------------
# Los Excel se procesan en segundo plano: la API responde al instante con un job_id.
# true = el worker corre dentro de la API (suficiente para empezar).
# false = lánzalo aparte, uno o varios:  uv run python -m app.worker
IMPORT_WORKER_EMBEDDED=true
# Archivos procesados en paralelo por cada worker
IMPORT_WORKER_CONCURRENCY=2
# Segundos entre búsquedas de trabajos nuevos cuando el worker está libre
IMPORT_WORKER_POLL_SECONDS=2
# Un trabajo en proceso más antiguo que esto se considera caído y se reintenta
IMPORT_JOB_STALE_MINUTES=10
IMPORT_JOB_MAX_ATTEMPTS=3
# Importaciones simultáneas (pendientes o en proceso) permitidas por profesor
IMPORT_MAX_PENDING_PER_TEACHER=5
