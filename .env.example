# =============================================================================
#  IA Grades Loader API - Variables de entorno
#  Copia este archivo a .env y completa los valores:  cp .env.example .env
#  Los pasos para obtener cada valor están en el README (sección "Variables de entorno").
# =============================================================================

# --- Aplicación --------------------------------------------------------------
APP_NAME="IA Grades Loader API"
# development | staging | production
APP_ENV=development
# Solo en desarrollo: con DEBUG=true los errores devuelven la traza completa. La API no
# arranca con DEBUG=true y APP_ENV distinto de development.
DEBUG=false
# Nivel de los logs: DEBUG, INFO, WARNING o ERROR
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# Orígenes permitidos para CORS, separados por coma (front Tauri / Vite)
CORS_ORIGINS=http://localhost:1420,tauri://localhost,http://tauri.localhost
# Swagger (/docs), ReDoc y /openapi.json. Vacío = visibles salvo con APP_ENV=production
API_DOCS_ENABLED=
# Código que pide el instalador (POST /api/v1/setup) para crear el super admin. Obligatorio
# con APP_ENV=production: sin él nadie puede instalar (evita que un desconocido se adelante
# y se haga admin de una API recién desplegada). Genera uno con:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(24))"
SETUP_TOKEN=

# --- Base de datos (MySQL) ---------------------------------------------------
# Formato: mysql+asyncmy://USUARIO:CLAVE@HOST:PUERTO/NOMBRE_BD
# (si tu proveedor la da como mysql://...?ssl-mode=REQUIRED, también vale: la API usa
# asyncmy y convierte ssl-mode en una conexión SSL)
DATABASE_URL=mysql+asyncmy://root:CLAVE@localhost:3306/ia_grades_loader_db
# true para ver el SQL generado en consola
DATABASE_ECHO=false
# Conexiones a la base: fijas, extra en picos y segundos de espera por una libre
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=10

# --- Autenticación (JWT) -----------------------------------------------------
# Genera un valor aleatorio:  uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Longitud de la contraseña generada automáticamente para estudiantes
GENERATED_PASSWORD_LENGTH=10
# No hay credenciales iniciales: el super admin se crea desde el instalador
# (POST /api/v1/setup), que solo está disponible mientras no exista ninguno.

# Protección contra fuerza bruta: intentos de login fallidos permitidos por cuenta y por IP
# en la ventana de minutos indicada; al superarlos responde 429 hasta que pase. 0 = sin límite
LOGIN_MAX_FAILURES_PER_ACCOUNT=10
LOGIN_MAX_FAILURES_PER_IP=50
LOGIN_FAILURE_WINDOW_MINUTES=15

# --- Modelo de IA ------------------------------------------------------------
# Cualquier proveedor compatible con la API de OpenAI (Chat Completions).
# Para cambiar de modelo basta con cambiar estas variables, sin tocar código.
#   DeepSeek : LLM_BASE_URL=https://api.deepseek.com          LLM_MODEL=deepseek-chat
#   OpenAI   : LLM_BASE_URL=https://api.openai.com/v1         LLM_MODEL=gpt-4o-mini
#   Groq     : LLM_BASE_URL=https://api.groq.com/openai/v1    LLM_MODEL=<modelo>
#   Ollama   : LLM_BASE_URL=http://localhost:11434/v1         LLM_MODEL=<modelo local>  (LLM_API_KEY=ollama)
# LLM_PROVIDER es solo una etiqueta informativa (logs / health).
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Mensajes previos que el chat reenvía al modelo (más = más contexto y más coste)
CHAT_MAX_HISTORY=10
# Máximo de preguntas a la IA por minuto y estudiante (app y Telegram juntos); 0 = sin límite.
# Protege del abuso y del gasto en el proveedor de IA.
CHAT_RATE_LIMIT_PER_MINUTE=10
# Tope de tokens de cada respuesta del asistente (acota coste y tiempo)
LLM_CHAT_MAX_TOKENS=1500

# Las reglas académicas (escala de notas, nota aprobatoria, lapsos, periodos) ya no van aquí:
# las configura el super admin desde la app (Configuración).

# --- Telegram ----------------------------------------------------------------
# Token del bot entregado por @BotFather (formato 123456789:AA...)
TELEGRAM_BOT_TOKEN=
# Username del bot sin "@" (se usa para generar el enlace t.me/<username>?start=<codigo>)
TELEGRAM_BOT_USERNAME=
# URL pública HTTPS donde Telegram enviará las actualizaciones. Si pones solo el dominio,
# la API añade la ruta /api/v1/telegram/webhook.
# Vacío = modo polling (recomendado en desarrollo local; no necesita URL pública).
# localhost o http:// no sirven: Telegram no puede llamarlos (la API usará polling).
# Ej.: https://mi-dominio.com/api/v1/telegram/webhook
# Con ngrok: https://<id>.ngrok-free.app/api/v1/telegram/webhook (cambia al reiniciar ngrok)
TELEGRAM_WEBHOOK_URL=
# Secreto que Telegram envía en la cabecera X-Telegram-Bot-Api-Secret-Token.
# Solo letras, números, "_" y "-" (1-256 caracteres). Genera uno con:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# Minutos de validez del código para vincular la cuenta de Telegram
TELEGRAM_LINK_CODE_TTL_MINUTES=10
# true = el bot arranca junto a la API. Pon false en instancias extra de la API: en modo
# polling solo un proceso puede recibir los mensajes del bot.
TELEGRAM_BOT_EMBEDDED=true

# --- Carga de archivos -------------------------------------------------------
# Tamaño máximo de un Excel; las peticiones de más de MAX_UPLOAD_SIZE_MB + 1 MB se rechazan
# (413) antes de leerlas
MAX_UPLOAD_SIZE_MB=10

# --- Cola de importación de notas (Excel + IA) -------------------------------
# Los Excel se procesan en segundo plano: la API responde al instante con un job_id.
# true = el worker corre dentro de la API (suficiente para empezar).
# false = lánzalo aparte, uno o varios:  uv run python -m app.worker
IMPORT_WORKER_EMBEDDED=true
# Archivos procesados en paralelo por cada worker
IMPORT_WORKER_CONCURRENCY=2
# Segundos entre búsquedas de trabajos nuevos cuando el worker está libre
IMPORT_WORKER_POLL_SECONDS=2
# Un trabajo en proceso más antiguo que esto se considera caído y se reintenta
IMPORT_JOB_STALE_MINUTES=10
IMPORT_JOB_MAX_ATTEMPTS=3
# Importaciones simultáneas (pendientes o en proceso) permitidas por profesor
IMPORT_MAX_PENDING_PER_TEACHER=5

# --- Docker (solo para docker compose) ---------------------------------------
# El contenedor de MySQL se crea con estos datos y la API se conecta a él
# (docker compose construye DATABASE_URL; la de arriba se ignora dentro de Docker).
MYSQL_DATABASE=ia_grades_loader
# Usuario propio de la app dentro del contenedor. NO puede ser "root" (la imagen de MySQL lo
# rechaza): root se configura solo con MYSQL_ROOT_PASSWORD.
MYSQL_USER=grades
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Puerto del host donde se publica la API
API_PORT=8000
